# Copy this file to `.env` in the project root and fill in real values.
# Never commit the real `.env` file — it's already in .gitignore.

# ── Database (from your cPanel PostgreSQL setup) ─────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password
DB_NAME=your_cpanel_db_name
# Most shared cPanel Postgres does NOT need SSL. Only set this to true if
# your host specifically requires it.
DB_SSL=false

# ── Server ────────────────────────────────────────────────────────────────
# cPanel's "Setup Node App" assigns its own port automatically and sets
# PORT for you — this fallback is only used for local development.
PORT=3001
NODE_ENV=production

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate a long random value for this — e.g. run in a terminal:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Anyone with this value can forge admin logins, so treat it like a password.
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session stays valid before needing to sign in again.
JWT_EXPIRES_IN=12h

# ── Admin login path ────────────────────────────────────────────────────
# The frontend route where the login page lives, instead of the guessable
# "/admin". Pick something only your team knows, with no spaces.
#
# The VITE_ prefix is required — Vite only exposes prefixed variables to
# the frontend, and only reads this file's values in at BUILD time, not
# runtime. That means changing this value later requires re-running
# `npm run build` and redeploying, not just restarting the server.
VITE_ADMIN_LOGIN_PATH=staff-portal-7k2m
